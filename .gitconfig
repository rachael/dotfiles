[user]
	email = github@rachael.io
	name = Rachael
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[core]
	hooksPath = /Users/rae/.config/git/hooks
[alias]
	agent-log = "!f(){ git log --date=short --format=\"%h %ad %an | %s | model: %(trailers:key=Co-Authored-By,valueonly,separator=%x2C) | harness: %(trailers:key=Agent-Harness,valueonly)\" \"$@\" | sed \"s/ <noreply@anthropic.com>//g\"; }; f"
	agent-commits = "!f(){ m=\"$1\"; shift; git log --date=short --format=\"%h %ad %s\" --grep=\"Co-Authored-By: .*$m\" -i \"$@\"; }; f"
